# ============================================================
# Sheraton Clone — Environment Variables Configuration
# ============================================================

# Server Port (default 3000)
PORT=3000

# Custom DNS servers to resolve MongoDB Atlas SRV records
DNS_SERVERS=8.8.8.8,8.8.4.4,1.1.1.1

# MongoDB Connection String (Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sheraton?retryWrites=true&w=majority

# ── Luxury Nodemailer Email Configuration ───────────────────
# GMAIL_USER: Your full Gmail address
GMAIL_USER=your_email@gmail.com

# GMAIL_PASS: 16-character Google App Password (NOT your regular Gmail password)
# How to get it:
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Search for "App Passwords" or navigate to Security > 2-Step Verification > App Passwords
# 3. Create a new App Password (name: "Sheraton Email Service") and paste the 16 characters below
GMAIL_PASS=xxxx xxxx xxxx xxxx

# Allowed Origins for CORS (comma separated)
ALLOWED_ORIGINS=https://sheraton-clone.vercel.app,http://localhost:3000,http://127.0.0.1:3000
