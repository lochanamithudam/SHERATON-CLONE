{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.(css|js|jpg|jpeg|png|gif|webp|avif|mp4|svg|ico|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/Rooms/(.*)",
      "dest": "/Rooms/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
